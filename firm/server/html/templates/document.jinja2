{% extends "layout.jinja2" %}

{% block title %}
FIRM {{ resource.type }}: {% if resource.name %}{{ resource.name }}{% else  %}{{ resource.id }}{% endif %}
{% endblock %}

{% block main %}
{% if resource.inReplyTo %}
<div class="mb-2 text-sm text-gray-500 dark:text-gray-400">
    <i class="fas fa-reply mr-1"></i>
    Reply to: <a href="{{ resource.inReplyTo}}">{{ resource.inReplyTo | safe }}</a>
</div>
{% endif %}
<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-2 mb-2">
    <div class="mb-2">        {% for field in ["to", "cc", "bcc", "bto"] %}
        {% if resource[field] %}
        <div class="flex space-x-2">
            <span class="font-semibold text-gray-700 dark:text-gray-300 capitalize min-w-0">{{ field }}:</span>
            <div class="text-blue-600 dark:text-blue-400 break-all">
                {% if resource[field] is string %}
                    {% if resource[field] == "https://www.w3.org/ns/activitystreams#Public" %}
                        as:Public
                    {% else %}
                        {{ resource[field] }}
                    {% endif %}
                {% endif %}
                {% if resource[field] is iterable %}
                    {% set formatted_items = [] %}
                    {% for item in resource[field] %}
                        {% if item == "https://www.w3.org/ns/activitystreams#Public" %}
                            {% set _ = formatted_items.append("as:Public") %}
                        {% else %}
                            {% set _ = formatted_items.append(item) %}
                        {% endif %}
                    {% endfor %}
                    {{ formatted_items | join(", ") }}
                {% endif %}
            </div>
        </div>
        {% endif %}
        {% endfor %}
    </div>

    {% if resource.published %}
    <div class="text-sm text-gray-600 dark:text-gray-400">
        <span class="font-semibold">Published:</span> {{ resource.published }}
    </div>
    {% endif %}
</div>

<div class="pl-4 mb-2 bg-white dark:bg-gray-800 rounded-lg shadow-sm">
    <div class="mastodon-styling text-lg text-gray-700 dark:text-gray-300 prose dark:prose-invert max-w-none">
        {{ resource.content | safe }}
    </div>

    {% if resource.attachment %}
        {% set image_attachments = resource.attachment | selectattr("type", "equalto", "Document")| selectattr("mediaType", "match", "image/.*") | list %}
        {% if image_attachments %}
        <div class="mt-6">
            {% if image_attachments | length == 1 %}
                <!-- Single image: display larger -->
                {% set attachment = image_attachments[0] %}
                <div class="group relative bg-gray-100 dark:bg-gray-700 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200 max-w-2xl">
                    <div class="aspect-video overflow-hidden">
                        <img
                            src="{{ attachment.url }}"
                            alt="{{ attachment.name or 'Image attachment' }}"
                            class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-200 cursor-pointer"
                            onclick="openImageModal('{{ attachment.url }}', '{{ attachment.name or 'Image attachment' }}')"
                            loading="lazy"
                        />
                    </div>
                    {% if attachment.name %}
                    <div class="absolute bottom-0 left-0 right-0 bg-black bg-opacity-50 text-white text-sm p-3 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                        {{ attachment.name }}
                    </div>
                    {% endif %}
                </div>
            {% else %}
                <!-- Multiple images: display in grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                    {% for attachment in image_attachments %}
                    <div class="group relative bg-gray-100 dark:bg-gray-700 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200">
                        <div class="aspect-square overflow-hidden">
                            <img
                                src="{{ attachment.url }}"
                                alt="{{ attachment.name or 'Image attachment' }}"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200 cursor-pointer"
                                onclick="openImageModal('{{ attachment.url }}', '{{ attachment.name or 'Image attachment' }}')"
                                loading="lazy"
                            />
                        </div>
                        {% if attachment.name %}
                        <div class="absolute bottom-0 left-0 right-0 bg-black bg-opacity-50 text-white text-xs p-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                            {{ attachment.name }}
                        </div>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        {% endif %}
    {% endif %}
</div>

<!-- Image Modal -->
<div id="imageModal" class="fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 hidden" onclick="closeImageModal()">
    <div class="max-w-4xl max-h-full p-4">
        <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain">
        <div id="modalCaption" class="text-white text-center mt-2 text-sm"></div>
    </div>
    <button class="absolute top-4 right-4 text-white text-2xl hover:text-gray-300" onclick="closeImageModal()">&times;</button>
</div>

<div class="mt-4 text-sm text-gray-600 dark:text-gray-400 break-all">
    <img style="display: inline" src="/static/images/activitypub-icon.svg" alt="ActivityPub" class="h-4 w-4 mr-2" />
    {{ resource.id }}
</div>

<script>
function openImageModal(src, alt) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    const modalCaption = document.getElementById('modalCaption');

    modalImage.src = src;
    modalImage.alt = alt;
    modalCaption.textContent = alt;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
}

function closeImageModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
}

// Close modal with Escape key
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeImageModal();
    }
});
</script>
{% endblock %}
